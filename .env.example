# true = datos locales de demostración; false = consumir la API del equipo
MIMASCOTA_DEMO_MODE=true

# URL base que entregará la compañera responsable del backend.
# Ejemplo: https://mi-servidor-equipoXX/api
MIMASCOTA_API_BASE_URL=http://127.0.0.1:5000/api
MIMASCOTA_REQUEST_TIMEOUT=12

# Token opcional si la API del equipo usa Bearer Token.
MIMASCOTA_API_TOKEN=
